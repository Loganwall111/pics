     return color;
 }
 
-vec3 fractalPhase(vec2 uv, float time, float glitchFactor, vec3 baseColor, float seed) {
+// BUILD #477 -- fractalPhase is a standalone world, like lavaHellscapePhase /
+// iceVoidPhase / spaceNebulaPhase below it: it builds `color` from the fractal
+// and the hue alone and never composites over the scene, which is why the call
+// site has always passed four arguments.
+//
+// It used to DECLARE a fifth -- `vec3 baseColor` -- that the body never read.
+// That is not a style problem: glslang has no matching overload for a 5-param
+// function called with 4, so `final.fsh` failed to compile in ALL NINE of its
+// define variants, 3 errors each, and `glslcheck/shimcheck.py` is a hard gate in
+// ci/build.sh (the `else` branch exits 1). One unused parameter was enough to
+// stop the shaderpack from building at all.
+//
+// Removing the parameter (rather than feeding the call site a fifth argument)
+// is the honest fix: the neighbours this one is written alongside take exactly
+// these four, and a parameter that is declared but ignored reads as compositing
+// that does not happen.
+vec3 fractalPhase(vec2 uv, float time, float glitchFactor, float seed) {
     vec2 p = (uv - 0.5) * (2.0 + hash1(seed) * 3.0);
     float angle = time * 0.0003 + seed * 0.01;
     float s = sin(angle), c = cos(angle);
