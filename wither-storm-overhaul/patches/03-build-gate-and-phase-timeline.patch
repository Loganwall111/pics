+# ---------------------------------------------------------------------------
+# BUILD #477 -- THE ROUTING GUARD.
+#
+# TEAL_TO_PURPLE / PURPLE_TO_ROSE / ROSE_TO_EMBER above are described as
+# "identical in sky.fsh, position.fsh and McsmStormPhase.java". They were
+# identical there -- and nowhere else. Two more files route phases, they were
+# outside this module:
+#
+#   StormPalettes.java        4.95 / 5.30 / 5.52 / 5.92   (no ember stage at all)
+#   McsmStormAtmosphere.java  5.00 / 5.50 / 5.50 / 6.00   (no ember stage at all)
+#
+# Both are live: StormPalettes paints the base mod's fog/cloud/pulse, and
+# McsmStormAtmosphere is what StoryModeSkyTint asks for the sky tint. So the
+# build shipped three timelines, and the two that were unchecked both stopped
+# dead at phase ~6.0 while sky.fsh kept easing to 8.05 -- the storm stopped
+# reacting for the last quarter of its own arc. check_parity() could not see it:
+# it only ever looked at McsmStormPhase.java.
+#
+# The routing now has exactly ONE Java home, McsmPhaseTimeline.java, and the two
+# consumers delegate to it. This check is what keeps it that way:
+#
+#   1. every file that is SUPPOSED to quote the windows still does;
+#   2. no OTHER shipped Java file quotes them -- a second copy is how this
+#      drifted in the first place, so it is a build failure rather than a
+#      judgement call;
+#   3. the two consumers actually delegate to McsmPhaseTimeline.
+# ---------------------------------------------------------------------------
+JAVA_TIMELINE = "mcsm-extras/java/net/mcsm/extras/client/McsmPhaseTimeline.java"
+# Files that must state the windows themselves (shaders cannot import Java, and
+# McsmStormPhase.java is the blueprint's own resolver and pre-dates the timeline).
+ROUTING_OWNERS = [
+    "mcsm-core-shaders/core/sky.fsh",
+    "mcsm-core-shaders/core/position.fsh",
+    JAVA_SOURCE,
+    JAVA_TIMELINE,
+]
+# Files that must NOT state them: they route, so they delegate.
+ROUTING_DELEGATES = [
+    "mcsm-extras/java/net/dabicco/witherstormmod/client/StormPalettes.java",
+    "mcsm-extras/java/net/mcsm/extras/client/McsmStormAtmosphere.java",
+]
+CANONICAL_WINDOWS = [TEAL_TO_PURPLE, PURPLE_TO_ROSE, ROSE_TO_EMBER]
+JAVA_TREE = "mcsm-extras/java"
+_PHASE_RAMP = re.compile(r"(?:mcsm_ramp|ramp)\s*\(\s*[A-Za-z_][A-Za-z_0-9]*\s*,\s*"
+                         r"(-?\d+\.?\d*)[fFdD]?\s*,\s*(-?\d+\.?\d*)[fFdD]?")
+
+
+def windows_in(text):
+    """The (lo, hi) windows of every ramp call that ramps a named scalar."""
+    return [(float(m.group(1)), float(m.group(2))) for m in _PHASE_RAMP.finditer(text)]
+
+
+def _close(a, b):
+    return abs(a - b) <= 1.0e-6
+
+
+def check_routing(verbose=False):
+    """One Java home for the routing, and both consumers actually use it."""
+    ok = True
+    msgs = []
+    want = CANONICAL_WINDOWS
+    for rel in ROUTING_OWNERS:
+        try:
+            text = read(rel)
+        except OSError as exc:
+            ok = False
+            msgs.append("routing: cannot read %s: %s" % (rel, exc))
+            continue
+        got = windows_in(text)
+        missing = [w for w in want
+                   if not any(_close(w[0], g[0]) and _close(w[1], g[1]) for g in got)]
+        if missing:
+            ok = False
+            msgs.append("routing: %s no longer states %s (run: apply the palette_tables windows)"
+                        % (rel, " ".join("%.2f-%.2f" % w for w in missing)))
+        elif verbose:
+            msgs.append("routing ok: %s == %d windows" % (rel, len(got)))
+
+    # No second copy: any other shipped Java file that quotes a canonical window.
+    for root, _dirs, files in os.walk(os.path.join(ROOT, JAVA_TREE)):
+        for f in files:
+            if not f.endswith(".java"):
+                continue
+            rel = os.path.relpath(os.path.join(root, f), ROOT)
+            if rel in ROUTING_OWNERS:
+                continue
+            try:
+                text = read(rel)
+            except OSError:
+                continue
+            hits = [w for w in windows_in(text)
+                    if any(_close(w[0], c[0]) and _close(w[1], c[1]) for c in want)]
+            if hits:
+                ok = False
+                msgs.append("routing: %s states its own phase window %s -- it must "
+                            "call McsmPhaseTimeline instead (this is the drift #477 removed)"
+                            % (rel, " ".join("%.2f-%.2f" % w for w in hits)))
+
+    for rel in ROUTING_DELEGATES:
+        try:
+            text = read(rel)
+        except OSError as exc:
+            ok = False
+            msgs.append("routing: cannot read %s: %s" % (rel, exc))
+            continue
+        if "McsmPhaseTimeline" not in text:
+            ok = False
+            msgs.append("routing: %s does not delegate to McsmPhaseTimeline" % rel)
+        elif verbose:
+            msgs.append("routing ok: %s delegates" % rel)
+    return ok, msgs
+
+
 def main():
     verbose = "--quiet" not in sys.argv
     ok, msgs = check_parity(verbose=verbose)
     ok2, msgs2 = check_derived(verbose=verbose)
     ok3, msgs3 = check_hex(verbose=verbose)
-    for m in msgs + msgs2 + msgs3:
+    ok4, msgs4 = check_routing(verbose=verbose)
+    for m in msgs + msgs2 + msgs3 + msgs4:
