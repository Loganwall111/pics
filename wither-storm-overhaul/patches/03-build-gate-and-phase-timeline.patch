+++ b/mcsm-extras/java/net/mcsm/extras/client/McsmPhaseTimeline.java
@@ -0,0 +1,175 @@
+package net.mcsm.extras.client;
+
+import net.minecraft.util.Mth;
+
+/**
+ * ONE DEFINITION OF THE PHASE TIMELINE.
+ *
+ * <p>Before this class there were four: {@code core/sky.fsh}'s
+ * {@code mcsm_sky_reference()}, {@code StormPalettes.stageWeights()},
+ * {@code McsmStormAtmosphere.skyBlend()} and the unused
+ * {@code StormSkyDome.skyColor()}. They disagreed, and not by rounding:
+ *
+ * <pre>
+ *   source                 teal-&gt;purple    purple-&gt;rose   rose-&gt;ember
+ *   ---------------------  --------------  --------------  --------------
+ *   core/sky.fsh (real)    5.10 .. 5.50    5.75 .. 6.05    7.00 .. 8.05
+ *   StormPalettes          4.95 .. 5.42    5.52 .. 6.10    (absent)
+ *   McsmStormAtmosphere    4.90 .. 5.40    5.48 .. 6.12    (absent)
+ * </pre>
+ *
+ * <p>The consequence was visible in game. The shader kept easing rose into
+ * ember all the way to phase 8.05 while the Java palette stopped changing at
+ * 6.15, so for the last 1.9 phases of the storm -- a quarter of the whole arc
+ * -- the fog, cloud and pulse colours were frozen while the sky above them
+ * carried on moving. Fog and sky drift apart, and the storm "stops reacting".
+ *
+ * <p>The same file already documents fixing this exact defect on the shader
+ * side:
+ *
+ * <blockquote>"The branchy version this replaces ran the purple-&gt;rose easing
+ * across 5.75-6.05 but stopped TAKING that branch at p = 5.9: crossing 5.9
+ * snapped the sky ... in one frame, with no blend. That is one of the 'the
+ * colours haven't really changed at all' seams."</blockquote>
+ *
+ * <p>That seam was fixed in GLSL and never fixed in Java. This class is the
+ * fix, and it is deliberately the same three nested ramps expressed the same
+ * way, so the two languages cannot drift again.
+ *
+ * <h2>Why weights, not a branch</h2>
+ *
+ * The shader writes the nested mix directly:
+ *
+ * <pre>
+ *   col = mix(mix(teal, pur, ramp(p, 5.10, 5.50)), rose, ramp(p, 5.75, 6.05));
+ *   return mix(col, ember, ramp(p, 7.00, 8.05));
+ * </pre>
+ *
+ * Java cannot branch on the same expression without re-deriving the blend at
+ * every call site, so {@link #weights} expands that nest algebraically into
+ * four coefficients:
+ *
+ * <pre>
+ *   w[0] = (1-r1)(1-r2)(1-r3)   teal
+ *   w[1] =    r1 (1-r2)(1-r3)   purple
+ *   w[2] =        r2 (1-r3)     rose
+ *   w[3] =            r3        ember
+ * </pre>
+ *
+ * These sum to exactly 1 by construction, for every phase:
+ *
+ * <pre>
+ *   (1-r2)(1-r3)[(1-r1) + r1] + r2(1-r3) + r3
+ *     = (1-r2)(1-r3) + r2(1-r3) + r3
+ *     = (1-r3) + r3
+ *     = 1
+ * </pre>
+ *
+ * That matters. The old code normalised with {@code w[i] /= tot} and then
+ * recovered its "early storm" tint as {@code 1 - tot}, which is identically
+ * zero once the weights are normalised -- so {@code PULSE_EARLY} was reachable
+ * only through a hard step at 4.95, one more unwarned seam. A partition of
+ * unity has no such step and needs no normalisation.
+ */
+public final class McsmPhaseTimeline {
+
+    /** The phase window the story track is defined over. Single definition. */
+    public static final float MIN = 4.45F;
+    public static final float MAX = 8.05F;
+
+    /** Storm has real mass from here; below it nothing storm-driven paints. */
+    public static final float ACTIVE = 4.45F;
+
+    // ---- the three nested ramps, verbatim from mcsm_sky_reference() --------
+    public static final float TEAL_TO_PUR_LO = 5.10F;
+    public static final float TEAL_TO_PUR_HI = 5.50F;
+    public static final float PUR_TO_ROSE_LO = 5.75F;
+    public static final float PUR_TO_ROSE_HI = 6.05F;
+    public static final float ROSE_TO_EMBER_LO = 7.00F;
+    public static final float ROSE_TO_EMBER_HI = 8.05F;
+
+    /** Storm bleeds into the ordinary sky over this window (sky.fsh:292). */
+    public static final float RISE_LO = 4.45F;
+    public static final float RISE_HI = 4.90F;
+
+    /** Number of palette stages: teal, purple, rose, ember. */
+    public static final int STAGES = 4;
+
+    public static final int TEAL = 0;
+    public static final int PURPLE = 1;
+    public static final int ROSE = 2;
+    public static final int EMBER = 3;
+
+    private McsmPhaseTimeline() {
+    }
+
+    /**
+     * Smoothstep, exactly as {@code mcsm_ramp} in the shaders:
+     * {@code t*t*(3-2t)} on the clamped parameter, and a step at the end for a
+     * degenerate window so both languages agree there too.
+     */
+    public static float ramp(float v, float lo, float hi) {
+        if (hi <= lo) {
+            return v >= hi ? 1.0F : 0.0F;
+        }
+        float t = Mth.clamp((v - lo) / (hi - lo), 0.0F, 1.0F);
+        return t * t * (3.0F - 2.0F * t);
+    }
+
+    /**
+     * Write the four stage weights for {@code phase} into {@code w}.
+     *
+     * <p>Guaranteed: every entry is in [0,1] and the four sum to 1.0 for any
+     * input, in range or not. Callers may therefore blend without normalising
+     * and without guarding against a zero total -- the failure mode that made
+     * the old {@code tot < 1.0E-4F} branch a second, different definition of
+     * the palette.
+     */
+    public static void weights(float phase, float[] w) {
+        float r1 = ramp(phase, TEAL_TO_PUR_LO, TEAL_TO_PUR_HI);
+        float r2 = ramp(phase, PUR_TO_ROSE_LO, PUR_TO_ROSE_HI);
+        float r3 = ramp(phase, ROSE_TO_EMBER_LO, ROSE_TO_EMBER_HI);
+        float not2 = 1.0F - r2;
+        float not3 = 1.0F - r3;
+        w[TEAL] = (1.0F - r1) * not2 * not3;
+        w[PURPLE] = r1 * not2 * not3;
+        w[ROSE] = r2 * not3;
+        w[EMBER] = r3;
+    }
+
+    /**
+     * How far the storm has taken the sky, 0..1, using the same rise window
+     * the shader uses. 0 below {@link #MIN}; 1 from {@link #RISE_HI} on.
+     */
+    public static float presence(float phase) {
+        return ramp(phase, RISE_LO, RISE_HI);
+    }
+
+    /** Linear blend of two RGB triples into {@code out}. */
+    public static float[] mix3(float[] out, float[] a, float[] b, float t) {
+        out[0] = a[0] + (b[0] - a[0]) * t;
+        out[1] = a[1] + (b[1] - a[1]) * t;
+        out[2] = a[2] + (b[2] - a[2]) * t;
+        return out;
+    }
+
+    /**
+     * Blend a four-stage palette by the timeline weights.
+     *
+     * <p>{@code stages} must hold four RGB triples indexed
+     * {@link #TEAL}, {@link #PURPLE}, {@link #ROSE}, {@link #EMBER}. This is
+     * the shape every palette in the mod already has, so each one only has to
+     * supply its own colours and can no longer supply its own windows.
+     */
+    public static float[] blend(float[] out, float phase, float[][] stages) {
+        float[] w = new float[STAGES];
+        weights(phase, w);
+        out[0] = stages[0][0] * w[0] + stages[1][0] * w[1]
+               + stages[2][0] * w[2] + stages[3][0] * w[3];
+        out[1] = stages[0][1] * w[0] + stages[1][1] * w[1]
+               + stages[2][1] * w[2] + stages[3][1] * w[3];
+        out[2] = stages[0][2] * w[0] + stages[1][2] * w[1]
+               + stages[2][2] * w[2] + stages[3][2] * w[3];
+        return out;
+    }
+}
